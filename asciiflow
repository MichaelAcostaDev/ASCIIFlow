#!/usr/bin/env bash
set -Eeuo pipefail

# ASCIIFlow - ASCII Text Banner Generator
# Main entry point

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ASCIIFLOW_ROOT="${ASCIIFLOW_ROOT:-$SCRIPT_DIR}"

# Load core modules
source "${ASCIIFLOW_ROOT}/src/fonts.sh"
source "${ASCIIFLOW_ROOT}/src/renderer.sh"
source "${ASCIIFLOW_ROOT}/src/cli.sh"

# Run the CLI parser
parse_cli "$@"
